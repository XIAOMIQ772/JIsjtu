OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=

CANVAS_API_TOKEN=

# jAccount 账号或交大邮箱地址，以及 jAccount 登录密码。
EMAIL_USER_ACCOUNT=
EMAIL_USER_PASSWORD=

# 邮箱如需独立客户端授权码，填在 IMAP_PASSWORD；留空时沿用 EMAIL_USER_PASSWORD。
IMAP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993

AGENT_HTTP_PORT=13376
AGENT_TCP_PORT=8081

# 启动时自动登录；设为 0 跳过，仍可调用 sso_login 或使用 --sso-login。
AGENT_SSO_AUTO_LOGIN=1
# SSO 登录和网页查询默认在后台无窗口完成；设为 0 供手动验证或排查问题。
AGENT_SSO_HEADLESS=1
# 可选：安装了 requirements-sso.txt 依赖的 Python 解释器。
# AGENT_SSO_PYTHON=/absolute/path/to/python3
# 可选：浏览器可执行文件；默认优先查找 Edge，其次 Chrome / Chromium。
# AGENT_SSO_BROWSER=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge
# 可选：私有浏览器配置与登录状态目录，默认当前工作目录的 .sso。
# AGENT_SSO_DIR=/absolute/path/to/private/sso
