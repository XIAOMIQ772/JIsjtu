OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=

CANVAS_API_TOKEN=

# 程序运行期间通过 macOS 通知提醒：未完成的 DDL 提前一小时、上课提前十分钟。设为 0 可关闭。
AGENT_REMINDERS=1

# jAccount 账号或交大邮箱地址，以及 jAccount 登录密码。
EMAIL_USER_ACCOUNT=
EMAIL_USER_PASSWORD=

# 选课社区登录。邮箱可填账号前缀或完整的 @sjtu.edu.cn 地址，密码使用在社区设置的密码。
JCOURSE_EMAIL=
JCOURSE_PASSWORD=

# 邮箱如需独立客户端授权码，填在 IMAP_PASSWORD；留空时沿用 EMAIL_USER_PASSWORD。
IMAP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993

# 交大邮箱发信使用 SMTP over TLS。独立 SMTP 授权码留空时沿用 IMAP_PASSWORD 或 EMAIL_USER_PASSWORD。
SMTP_HOST=mail.sjtu.edu.cn
SMTP_PORT=465
SMTP_PASSWORD=

# HTTP 和 TCP 默认只接受本机连接。仅在明确需要局域网访问时设为指定网卡 IP 或 0.0.0.0。
AGENT_BIND_ADDR=127.0.0.1
AGENT_HTTP_PORT=13376
AGENT_TCP_PORT=8081

# 启动时自动登录；设为 0 跳过，仍可调用 sso_login 或使用 --sso-login。
AGENT_SSO_AUTO_LOGIN=1
# SSO 登录和网页查询默认在后台无窗口完成；设为 0 供手动验证或排查问题。
AGENT_SSO_HEADLESS=1
# 可选：安装了 requirements-sso.txt 依赖的 Python 解释器。
# AGENT_SSO_PYTHON=/absolute/path/to/python3
# 可选：浏览器可执行文件；默认优先查找 Edge，其次 Chrome / Chromium。
# AGENT_SSO_BROWSER=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge
# 可选：私有浏览器配置与登录状态目录，默认当前工作目录的 .sso。
# AGENT_SSO_DIR=/absolute/path/to/private/sso

# 可选：新学期校历尚未内置时，指定第 1 周周一的日期、总周数与学期名称（下面的日期只是示例，请按教务处公布的校历填写）。
# SJTU_TERM_START=2026-09-14
# SJTU_TERM_WEEKS=18
# SJTU_TERM_NAME=2026-2027 学年秋季学期
